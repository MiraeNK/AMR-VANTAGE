<UserControl x:Class="FMR.AisinAMR.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FMR.AisinAMR.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BG.Shell}">
    <UserControl.Resources>
        <conv:MapCoordinateToCanvasConverter x:Key="MapCoordinateToCanvasConverter" />
    </UserControl.Resources>
    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Map View" Foreground="{StaticResource Text.Primary}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Visualisasi peta dan posisi robot secara realtime." Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,8,0,24" />

            <!-- Select Robot ComboBox -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Select Robot:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding RobotList}" SelectedItem="{Binding RobotSelected, Mode=TwoWay}" DisplayMemberPath="RobotName" Width="200" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <Border Style="{StaticResource MetricCard}" Padding="0" ClipToBounds="True" MinHeight="400">
                <Grid x:Name="MapContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      MouseWheel="MapContainer_MouseWheel"
                      MouseRightButtonDown="MapContainer_MouseRightButtonDown"
                      MouseRightButtonUp="MapContainer_MouseRightButtonUp"
                      MouseMove="MapContainer_MouseMove">
                    
                    <Canvas x:Name="MapCanvas"
                            Width="680"
                            Height="460"
                            Background="#05101F"
                            MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                            MouseMove="MapCanvas_MouseMove"
                            MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                            Cursor="Cross">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MapScaleTransform" />
                                <TranslateTransform x:Name="MapTranslateTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                            
                        <!-- Background Map Image -->
                        <Image x:Name="MapImage" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Panel.ZIndex="0" />
                    </Canvas>

                    <!-- Mode Indicator -->
                    <Border x:Name="ModeIndicatorBorder" Background="#B2000000" CornerRadius="4" Padding="8,4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtModeIndicator" Text="MODE: Normal" Foreground="{StaticResource Accent.Cyan}" FontSize="12" FontWeight="Bold" />
                    </Border>

                    <!-- Overlay Texts (Fixed position, immune to zoom) -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,10">
                        <TextBlock Text="Robot position" Foreground="{StaticResource Text.Secondary}" FontSize="10" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding RobotSelected.PoseX, StringFormat='X: {0:F2}'}" Foreground="{StaticResource Text.Primary}" FontSize="12" FontWeight="SemiBold" Width="60" />
                            <TextBlock Text="{Binding RobotSelected.PoseY, StringFormat='Y: {0:F2}'}" Foreground="{StaticResource Text.Primary}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
            <Border Style="{StaticResource MetricCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Map Controls" Foreground="{StaticResource Text.Primary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource MaterialDesignOutlinedButton}" Content="Load Map" Click="LoadMap_Click" Height="38" />
                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedButton}" Content="Fit Screen" Click="FitMap_Click" Height="38" />
                    </Grid>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Resolution (m/px)" Foreground="{StaticResource Text.Secondary}" FontSize="12" />
                        <TextBox Text="{Binding MapResolution, Mode=TwoWay}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" Height="48" />
                    </StackPanel>
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Origin X" Foreground="{StaticResource Text.Secondary}" FontSize="12" />
                            <TextBox Text="{Binding OriginX, Mode=TwoWay}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" Height="48" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Origin Y" Foreground="{StaticResource Text.Secondary}" FontSize="12" />
                            <TextBox Text="{Binding OriginY, Mode=TwoWay}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" Height="48" />
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Mode" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,8,0,4" />
                    <ToggleButton x:Name="ToggleInitialPose"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Height="38"
                                  Foreground="{StaticResource Accent.Green}"
                                  BorderBrush="{StaticResource Accent.Green}"
                                  Checked="ToggleInitialPose_Checked"
                                  Unchecked="ToggleMode_Unchecked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MapMarkerCheck" Width="16" Height="16"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Set Initial Pose" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="ToggleNavGoal"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Height="38" Margin="0,6,0,0"
                                  Foreground="{StaticResource Accent.Cyan}"
                                  BorderBrush="{StaticResource Accent.Cyan}"
                                  Checked="ToggleNavGoal_Checked"
                                  Unchecked="ToggleMode_Unchecked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Navigation" Width="16" Height="16"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Set Nav Goal" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <TextBlock Text="Robot" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X: " Foreground="{StaticResource Text.Muted}" FontSize="12" />
                        <TextBlock Text="{Binding RobotSelected.PoseX, StringFormat='{}{0:F3} m'}" Foreground="{StaticResource Text.Primary}" FontSize="12" Width="60" />
                        <TextBlock Text="Y: " Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding RobotSelected.PoseY, StringFormat='{}{0:F3} m'}" Foreground="{StaticResource Text.Primary}" FontSize="12" Width="60" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Yaw: " Foreground="{StaticResource Text.Muted}" FontSize="12" />
                        <TextBlock Text="{Binding RobotSelected.PoseYaw, StringFormat='{}{0:F1}°'}" Foreground="{StaticResource Text.Primary}" FontSize="12" />
                    </StackPanel>

                    <TextBlock Text="Action" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,16,0,4" />
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding CancelNavCommand}" Height="38">
                        <TextBlock Text="Cancel Nav" />
                    </Button>
                    <Button Margin="0,6,0,0" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding EStopCommand}" CommandParameter="{Binding RobotSelected}" Height="38" Foreground="Red" BorderBrush="Red">
                        <TextBlock Text="E-Stop" />
                    </Button>
                    
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Map Info" Foreground="{StaticResource Text.Secondary}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtMapFileInfo" Text="No map loaded" Foreground="{StaticResource Text.Primary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Click canvas to send goal" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
