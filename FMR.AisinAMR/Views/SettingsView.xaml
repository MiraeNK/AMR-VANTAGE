<UserControl x:Class="FMR.AisinAMR.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BG.Shell}">
    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Settings"
                       Foreground="{StaticResource Text.Primary}"
                       FontSize="22"
                       FontWeight="Bold" />
            <TextBlock Text="Konfigurasi MQTT, jaringan, dan integrasi sistem."
                       Foreground="{StaticResource Text.Secondary}"
                       FontSize="12"
                       Margin="0,8,0,24" />

            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="MQTT Broker Port"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="12" />
                        <TextBox Text="{Binding MqttBrokerPort, Mode=TwoWay}"
                                 materialDesign:HintAssist.Hint="e.g. 1883"
                                 Margin="0,6,0,0"
                                 Height="48"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Robot ID"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="12" />
                        <TextBox Text="{Binding SelectedRobotId, Mode=TwoWay}"
                                 materialDesign:HintAssist.Hint="e.g. R01"
                                 Margin="0,6,0,0"
                                 Height="48"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Map file path"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="12" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBox Text="{Binding MapFilePath, Mode=TwoWay}"
                                     materialDesign:HintAssist.Hint="Path to .yaml map file"
                                     Height="48"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117"
                                     DockPanel.Dock="Left"
                                     HorizontalAlignment="Stretch" />
                            <Button Content="Browse"
                                    Width="90"
                                    Margin="8,0,0,0"
                                    Click="BrowseMapPath_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Map resolution (m/pixel)"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="12" />
                        <TextBox Text="{Binding MapResolution, Mode=TwoWay, StringFormat=F2}"
                                 materialDesign:HintAssist.Hint="e.g. 0.05"
                                 Margin="0,6,0,0"
                                 Height="48"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="140" Margin="0,0,12,0">
                            <TextBlock Text="Origin X"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="12" />
                            <TextBox Text="{Binding OriginX, Mode=TwoWay, StringFormat=F2}"
                                     materialDesign:HintAssist.Hint="e.g. -10.5"
                                     Margin="0,6,0,0"
                                     Height="48"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" />
                        </StackPanel>
                        <StackPanel Width="140">
                            <TextBlock Text="Origin Y"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="12" />
                            <TextBox Text="{Binding OriginY, Mode=TwoWay, StringFormat=F2}"
                                     materialDesign:HintAssist.Hint="e.g. -10.5"
                                     Margin="0,6,0,0"
                                     Height="48"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding AutoPublishInitialPose, Mode=TwoWay}"
                                      Content="Auto-publish initial pose"
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="36" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding SaveSettingsCommand}"
                                Width="110"
                                Height="36">
                            <TextBlock Text="Save" />
                        </Button>
                        <Button Margin="12,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ResetSettingsCommand}"
                                Width="140"
                                Height="36">
                            <TextBlock Text="Reset to Default" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- SSH Credentials Section -->
        <StackPanel Grid.Column="1" Margin="24,0,0,0">
            <TextBlock Text="SSH Credentials"
                       Foreground="{StaticResource Text.Primary}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,32,0,16" />
            
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="SSH Host IP"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="12" />
                        <TextBox Text="{Binding SshHostIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="e.g. 192.168.137.40"
                                 Margin="0,6,0,0"
                                 Height="48"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="SSH Username"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="12" />
                        <TextBox Text="{Binding SshUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="e.g. amr"
                                 Margin="0,6,0,0"
                                 Height="48"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="SSH Password"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="12" />
                        <!-- Using TextBox with password masking trick if possible, or just normal text since standard WPF PasswordBox doesn't support direct two-way binding easily -->
                        <TextBox Text="{Binding SshPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Enter password"
                                 Margin="0,6,0,0"
                                 Height="48"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" materialDesign:HintAssist.Foreground="#CCCCCC" materialDesign:HintAssist.Background="#0D1117" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="SSH Port"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="12" />
                        <TextBox Text="{Binding SshPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="e.g. 22"
                                 Margin="0,6,0,0"
                                 Height="48"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="{StaticResource Text.Primary}"
                                 materialDesign:HintAssist.Foreground="{StaticResource Text.Secondary}" />
                    </StackPanel>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding TestSshConnectionCommand}"
                            Height="36"
                            Margin="0,8,0,0">
                        <TextBlock Text="Test SSH Connection" />
                    </Button>
                    
                    <TextBlock Text="{Binding SshTestResult}"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="12"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
