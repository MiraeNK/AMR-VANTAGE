<Window x:Class="FMR.AisinAMR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:FMR.AisinAMR.ViewModels"
        xmlns:views="clr-namespace:FMR.AisinAMR.Views"
        mc:Ignorable="d"
        Title="Eqdev AMR — Fleet Management"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BG.Shell}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  ROOT GRID — Shell Layout                                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Border CornerRadius="12"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />   <!-- Header -->
                <RowDefinition Height="*" />    <!-- Body -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  HEADER — Row 0, span all columns               -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{StaticResource BG.Header}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" /> <!-- Sidebar width align -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand / Logo area -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0">
                        <!-- Logo icon -->
                        <Border Width="28" Height="28"
                                CornerRadius="6"
                                Background="{StaticResource Accent.Cyan}"
                                Margin="0,0,10,0">
                            <TextBlock Text="A"
                                       Foreground="#0D1117"
                                       FontSize="15"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="EQDEV AMR"
                                       Foreground="{StaticResource Text.Primary}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="PT AISIN INDONESIA"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="9"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center — page title -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentPageTitle}"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="16,0" />

                    <!-- Right — MQTT Status + Window Controls -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                               >

                        <!-- MQTT Server Status Badge -->
                        <Border CornerRadius="20"
                                Padding="12,5"
                                Background="#12291A">
                            <StackPanel Orientation="Horizontal">
                                <!-- Animated pulse dot -->
                                <Ellipse Width="8" Height="8"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Accent.Red}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMqttServerOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Accent.Green}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="MQTT Offline" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent.Red}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMqttServerOnline}" Value="True">
                                                    <Setter Property="Text" Value="MQTT Online" />
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Green}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Connected Robots Count -->
                        <Border CornerRadius="20"
                                Padding="12,5"
                                Background="#1A2035">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Forklift"
                                                         Width="14" Height="14"
                                                         Foreground="{StaticResource Accent.Cyan}"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectedRobotsCount, StringFormat='{}{0} Robot'}"
                                           Foreground="{StaticResource Accent.Cyan}"
                                           FontSize="11"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Divider -->
                        <Rectangle Width="1" Height="20"
                                   Fill="{StaticResource Border.Default}"
                                   Margin="4,0" />

                        <!-- Minimize -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Width="32" Height="32"
                                ToolTip="Minimize"
                                Click="BtnMinimize_Click">
                            <materialDesign:PackIcon Kind="WindowMinimize"
                                                     Width="14" Height="14"
                                                     Foreground="{StaticResource Text.Secondary}" />
                        </Button>

                        <!-- Maximize -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Width="32" Height="32"
                                ToolTip="Maximize"
                                Click="BtnMaximize_Click">
                            <materialDesign:PackIcon Kind="WindowMaximize"
                                                     Width="14" Height="14"
                                                     Foreground="{StaticResource Text.Secondary}" />
                        </Button>

                        <!-- Close -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Width="32" Height="32"
                                ToolTip="Close"
                                Click="BtnClose_Click">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="14" Height="14"
                                                     Foreground="{StaticResource Text.Secondary}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  SIDEBAR — Row 1, Col 0                         -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{StaticResource BG.Sidebar}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">

                    <!-- Nav Items -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">

                        <!-- Section label -->
                        <TextBlock Text="NAVIGATION"
                                   Foreground="{StaticResource Text.Muted}"
                                   FontSize="9"
                                   FontWeight="SemiBold" Margin="28,8,0,8" />

                        <!-- Dashboard -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Dashboard">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard">
                                            <Setter Property="Background" Value="#0E2030" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent.Cyan}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <!-- Active indicator bar -->
                                <Border Width="3" Height="20" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard">
                                                    <Setter Property="Background" Value="{StaticResource Accent.Cyan}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <materialDesign:PackIcon Kind="ViewDashboard"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="Dashboard"
                                           FontSize="13"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Robot Fleet -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Fleet">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Fleet">
                                            <Setter Property="Background" Value="#0E2030" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent.Cyan}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="20" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Fleet">
                                                    <Setter Property="Background" Value="{StaticResource Accent.Cyan}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <materialDesign:PackIcon Kind="Forklift"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="Robot Fleet"
                                           FontSize="13"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Map View -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Map">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Map">
                                            <Setter Property="Background" Value="#0E2030" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent.Cyan}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="20" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Map">
                                                    <Setter Property="Background" Value="{StaticResource Accent.Cyan}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <materialDesign:PackIcon Kind="MapOutline"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="Map View"
                                           FontSize="13"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Height="1"
                                   Fill="{StaticResource Border.Subtle}"
                                   Margin="20,12" />

                        <TextBlock Text="SYSTEM"
                                   Foreground="{StaticResource Text.Muted}"
                                   FontSize="9"
                                   FontWeight="SemiBold" Margin="28,0,0,8" />

                        <!-- Settings -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Settings">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                            <Setter Property="Background" Value="#0E2030" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent.Cyan}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="20" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                                    <Setter Property="Background" Value="{StaticResource Accent.Cyan}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <materialDesign:PackIcon Kind="Cog"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="Settings"
                                           FontSize="13"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom — version info -->
                    <Border DockPanel.Dock="Bottom"
                            Padding="20,16"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="FMR v1.0.0"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="10" />
                            <TextBlock Text="Eqdev · PT Aisin Indonesia"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  MAIN CONTENT AREA — Row 1, Col 1               -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Grid.Column="1"
                  Background="{StaticResource BG.Shell}">
                <views:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Dashboard}" />
                <views:FleetView    Visibility="{Binding CurrentPage, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Fleet}" />
                <views:MapView      Visibility="{Binding CurrentPage, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Map}" />
                <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Settings}" />
            </Grid>

        </Grid>
    </Border>
</Window>
