<UserControl x:Class="FMR.AisinAMR.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FMR.AisinAMR.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BG.Shell}">

    <UserControl.Resources>
        <conv:BoolToColorConverter      x:Key="BoolToColorConverter" />
        <conv:InvertBoolConverter       x:Key="InvertBoolConverter" />
        <conv:PercentToWidthConverter   x:Key="PercentToWidthConverter" />
        <BooleanToVisibilityConverter   x:Key="BoolToVis" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVis" />
    </UserControl.Resources>

    <!-- Root: two layers — main content (z=0) and SSH overlay (z=100) -->
    <Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  LAYER 0 — Main fleet content                              -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24">

                <!-- Page Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Robot Fleet"
                                   Foreground="{StaticResource Text.Primary}"
                                   FontSize="22" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="12">
                                <Run Text="{Binding ConnectedRobotsCount, Mode=OneWay}" />
                                <Run Text=" unit online" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Robot Card List -->
                <ItemsControl ItemsSource="{Binding RobotList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,16" CornerRadius="8"
                                    BorderThickness="1" Background="#0D1117">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#1E2A38" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="BorderBrush" Value="#1A4A3A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <!-- Card Header (clickable to expand detail) -->
                                    <Border Padding="20,16" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectRobotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Online status bar -->
                                            <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                    Margin="0,0,16,0" MinHeight="40">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FF1744" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Background" Value="#00E676" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Robot name + IP -->
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RobotName}"
                                                               Foreground="{StaticResource Text.Primary}"
                                                               FontSize="16" FontWeight="Bold" />
                                                    <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="4"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#2A1208" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                        <Setter Property="Background" Value="#122810" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="OFFLINE" />
                                                                    <Setter Property="Foreground" Value="#FF5252" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                            <Setter Property="Text" Value="ONLINE" />
                                                                            <Setter Property="Foreground" Value="#69F0AE" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="4"
                                                            Background="#1A2035" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentMode}"
                                                                   Foreground="{StaticResource Accent.Cyan}"
                                                                   FontSize="10" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="IP: " Foreground="{StaticResource Text.Muted}" FontSize="12" />
                                                    <TextBlock Text="{Binding IpAddress}"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               FontSize="12" FontFamily="Consolas" />
                                                    <TextBlock Text="  ID: " Foreground="{StaticResource Text.Muted}" FontSize="12" />
                                                    <TextBlock Text="{Binding RobotId}"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               FontSize="12" FontFamily="Consolas" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Battery indicator -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="BATTERY"
                                                           Foreground="{StaticResource Text.Muted}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0:F0}'}"
                                                               Foreground="{StaticResource Accent.Green}"
                                                               FontSize="22" FontWeight="Bold" />
                                                    <TextBlock Text=" %"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               FontSize="12" VerticalAlignment="Bottom"
                                                               Margin="0,0,0,3" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Detail Panel — only visible when this robot is selected -->
                                    <StackPanel>
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource EqualityToVis}">
                                                <Binding Path="RobotId" />
                                                <Binding Path="DataContext.RobotSelected.RobotId" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </StackPanel.Visibility>

                                        <Separator Background="#1E2A38" Margin="0" />

                                        <StackPanel Margin="20,16,20,20">

                                            <!-- Metrics Row -->
                                            <UniformGrid Columns="3" Margin="0,0,0,16">

                                                <!-- Battery -->
                                                <Border Background="#080E14" CornerRadius="6"
                                                        BorderBrush="#1E2A38" BorderThickness="1"
                                                        Padding="14" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="BATTERY"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Margin="0,0,0,8" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0:F0}'}"
                                                                       Foreground="{StaticResource Accent.Green}"
                                                                       FontSize="36" FontWeight="Bold" />
                                                            <TextBlock Text=" %"
                                                                       Foreground="{StaticResource Text.Secondary}"
                                                                       FontSize="16" VerticalAlignment="Bottom"
                                                                       Margin="0,0,0,6" />
                                                        </StackPanel>
                                                        <Border Height="4" CornerRadius="2"
                                                                Background="#1E2A38" Margin="0,6,0,6">
                                                            <Border.Child>
                                                                <Border CornerRadius="2"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{StaticResource Accent.Green}">
                                                                    <Border.Width>
                                                                        <Binding Path="BatteryLevel"
                                                                                 Converter="{StaticResource PercentToWidthConverter}"
                                                                                 ConverterParameter="160" />
                                                                    </Border.Width>
                                                                </Border>
                                                            </Border.Child>
                                                        </Border>
                                                        <TextBlock Text="{Binding BatteryStatus}"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Position -->
                                                <Border Background="#080E14" CornerRadius="6"
                                                        BorderBrush="#1E2A38" BorderThickness="1"
                                                        Padding="14" Margin="4,0,4,0">
                                                    <StackPanel>
                                                        <TextBlock Text="POSITION"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Margin="0,0,0,8" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="X" Foreground="{StaticResource Text.Muted}" FontSize="10" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding PoseX, StringFormat='{}{0:F3}'}"
                                                                               Foreground="{StaticResource Accent.Cyan}"
                                                                               FontSize="18" FontWeight="Bold" />
                                                                    <TextBlock Text="m" Foreground="{StaticResource Text.Muted}"
                                                                               FontSize="10" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                                                                </StackPanel>
                                                                <TextBlock Text="Y" Foreground="{StaticResource Text.Muted}" FontSize="10" Margin="0,6,0,0" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding PoseY, StringFormat='{}{0:F3}'}"
                                                                               Foreground="{StaticResource Accent.Blue}"
                                                                               FontSize="18" FontWeight="Bold" />
                                                                    <TextBlock Text="m" Foreground="{StaticResource Text.Muted}"
                                                                               FontSize="10" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="YAW" Foreground="{StaticResource Text.Muted}" FontSize="10" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding PoseYaw, StringFormat='{}{0:F1}'}"
                                                                               Foreground="{StaticResource Text.Primary}"
                                                                               FontSize="18" FontWeight="Bold" />
                                                                    <TextBlock Text="°" Foreground="{StaticResource Text.Muted}"
                                                                               FontSize="10" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Velocity + NavState -->
                                                <Border Background="#080E14" CornerRadius="6"
                                                        BorderBrush="#1E2A38" BorderThickness="1"
                                                        Padding="14" Margin="8,0,0,0">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <TextBlock Text="VELOCITY"
                                                                       Foreground="{StaticResource Text.Muted}"
                                                                       FontSize="10" FontWeight="SemiBold" />
                                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                                    Background="#1A2035">
                                                                <TextBlock Text="{Binding NavState}"
                                                                           Foreground="{StaticResource Accent.Cyan}"
                                                                           FontSize="9" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="LINEAR" Foreground="{StaticResource Text.Muted}" FontSize="10" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding LinearVelocity, StringFormat='{}{0:F3}'}"
                                                                       Foreground="{StaticResource Accent.Orange}"
                                                                       FontSize="24" FontWeight="Bold" />
                                                            <TextBlock Text=" m/s" Foreground="{StaticResource Text.Muted}"
                                                                       FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                                        </StackPanel>
                                                        <TextBlock Text="ANGULAR" Foreground="{StaticResource Text.Muted}" FontSize="10" Margin="0,6,0,0" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding AngularVelocity, StringFormat='{}{0:F3}'}"
                                                                       Foreground="{StaticResource Text.Secondary}"
                                                                       FontSize="18" FontWeight="SemiBold" />
                                                            <TextBlock Text=" rad/s" Foreground="{StaticResource Text.Muted}"
                                                                       FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <!-- PLC + Status Row -->
                                            <Border Background="#080E14" CornerRadius="6"
                                                    BorderBrush="#1E2A38" BorderThickness="1"
                                                    Padding="16" Margin="0,0,0,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="PLC STATUS"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Margin="0,0,0,6" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#FF1744" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PlcConnected}" Value="True">
                                                                                <Setter Property="Fill" Value="#00E676" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Disconnected" />
                                                                        <Setter Property="Foreground" Value="#FF5252" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PlcConnected}" Value="True">
                                                                                <Setter Property="Text" Value="Connected" />
                                                                                <Setter Property="Foreground" Value="#69F0AE" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="HEARTBEAT"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding HeartbeatCount}"
                                                                   Foreground="{StaticResource Accent.Cyan}"
                                                                   FontSize="22" FontWeight="Bold" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="SSH STATUS"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding SshStatus}"
                                                                   Foreground="{StaticResource Accent.Blue}"
                                                                   FontSize="14" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Action Buttons -->
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding DataContext.StartNavigationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsLaunching, Converter={StaticResource InvertBoolConverter}}"
                                                        Foreground="{StaticResource Accent.Cyan}"
                                                        BorderBrush="{StaticResource Accent.Cyan}"
                                                        Margin="0,0,10,0" Height="38" Padding="16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="PlayCircleOutline"
                                                                                 Width="16" Height="16"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,6,0" />
                                                        <TextBlock Text="Start Navigation" VerticalAlignment="Center" FontSize="13" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding DataContext.StartMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsLaunching, Converter={StaticResource InvertBoolConverter}}"
                                                        Foreground="{StaticResource Accent.Orange}"
                                                        BorderBrush="{StaticResource Accent.Orange}"
                                                        Margin="0,0,10,0" Height="38" Padding="16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="MapOutline"
                                                                                 Width="16" Height="16"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,6,0" />
                                                        <TextBlock Text="Start Mapping" VerticalAlignment="Center" FontSize="13" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding DataContext.EStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="#FF1744" BorderBrush="#FF1744"
                                                        Height="38" Padding="16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="StopCircleOutline"
                                                                                 Width="16" Height="16"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,6,0" />
                                                        <TextBlock Text="E-Stop" VerticalAlignment="Center" FontSize="13" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Command Status & History -->
                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="COMMAND STATUS" Foreground="{StaticResource Text.Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <Border Background="#080E14" CornerRadius="6" BorderBrush="#1E2A38" BorderThickness="1" Padding="12">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                            <TextBlock Text="{Binding LastCommandType, StringFormat='Last Command: {0}'}" Foreground="{StaticResource Text.Primary}" FontSize="12" Width="180" />
                                                            <TextBlock Text="Status: " Foreground="{StaticResource Text.Secondary}" FontSize="12" />
                                                            <TextBlock Text="{Binding LastCommandStatus}" Foreground="{Binding LastCommandStatus, Converter={StaticResource CommandStatusColorConverter}}" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding LastCommandLatency, StringFormat='({0})'}" Foreground="#888" FontSize="11" />
                                                        </StackPanel>
                                                        
                                                        <ItemsControl ItemsSource="{Binding RosNodes}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                                                        <Ellipse Width="8" Height="8" Fill="{Binding Value, Converter={StaticResource NodeStatusColorConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Key}" Foreground="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <Expander Header="Command Log" Foreground="{StaticResource Text.Secondary}" BorderThickness="0" Background="Transparent" Margin="0,8,0,0">
                                                <ListBox ItemsSource="{Binding DataContext.CommandHistory, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                         Height="150" Background="#080E14" BorderBrush="#1E2A38" BorderThickness="1"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="{Binding SentAt, StringFormat='[{0:HH:mm:ss}] '}" Foreground="#888" FontSize="11" />
                                                                <TextBlock Text="{Binding CommandType}" Foreground="{StaticResource Text.Primary}" FontSize="11" Width="60" />
                                                                <TextBlock Text=" → " Foreground="#555" FontSize="11" />
                                                                <TextBlock Text="{Binding IsSuccess}" Foreground="{Binding LastCommandStatus, Converter={StaticResource CommandStatusColorConverter}}" FontSize="11" />
                                                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF1744" FontSize="11" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Expander>

                                        </StackPanel>
                                    </StackPanel>
                                    <!-- /Detail Panel -->

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  LAYER 1 — SSH Terminal Overlay (shown when popup open)    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSshPopupOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop -->
            <Border Background="#A0000000" />

            <!-- Dialog -->
            <Border Width="800" Height="600"
                    Background="#0D1117" CornerRadius="8"
                    BorderBrush="#30FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /> <!-- Section 1: Terminal -->
                        <RowDefinition Height="Auto" /> <!-- Section 2: Node Status -->
                        <RowDefinition Height="Auto" /> <!-- Section 3: Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="SSH LAUNCH"
                                   Foreground="{StaticResource Accent.Cyan}"
                                   FontSize="14" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Text="{Binding LaunchingRobot.RobotName, StringFormat='Robot: {0}'}"
                                   Foreground="#888" FontSize="11" FontFamily="Consolas" />
                    </StackPanel>

                    <!-- Section 1: Terminal Output -->
                    <Border Grid.Row="1" Background="#010409" CornerRadius="4"
                            BorderBrush="#21262D" BorderThickness="1" Margin="0,0,0,12">
                        <TextBox Text="{Binding LaunchingRobot.SshLog, Mode=OneWay}"
                                 Foreground="#39D353" Background="Transparent"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="12" />
                    </Border>

                    <!-- Section 2: Node Status -->
                    <Border Grid.Row="2" Background="#080E14" CornerRadius="6"
                            BorderBrush="#1E2A38" BorderThickness="1" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="NODE STATUS (Updated every 3s)" Foreground="{StaticResource Text.Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding LaunchingRobot.RosNodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                            <Ellipse Width="10" Height="10" Fill="{Binding Value, Converter={StaticResource NodeStatusColorConverter}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Key}" Foreground="{StaticResource Text.Primary}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Footer -->
                    <Grid Grid.Row="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Final Status: " Foreground="{StaticResource Text.Secondary}" FontSize="14" />
                            <TextBlock Text="{Binding LaunchingRobot.SshStatus}" Foreground="{StaticResource Accent.Cyan}" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Retry"
                                    Command="{Binding StartNavigationCommand}"
                                    CommandParameter="{Binding LaunchingRobot}"
                                    Foreground="{StaticResource Accent.Orange}"
                                    BorderBrush="{StaticResource Accent.Orange}"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LaunchingRobot.SshStatus}" Value="Error">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LaunchingRobot.SshStatus}" Value="Failed">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Close"
                                    Command="{Binding CloseSshPopupCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource Accent.Cyan}"
                                    BorderBrush="{StaticResource Accent.Cyan}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
