<UserControl x:Class="Vantage.Studio.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantage.Studio.ViewModels"
             xmlns:r="clr-namespace:Vantage.Studio.Rendering"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FleetViewModel}">
    <UserControl.Resources>
        <!-- portrait robot card -->
        <DataTemplate DataType="{x:Type vm:RobotCardViewModel}">
            <Border x:Name="card" Width="206" Height="304" Margin="0,0,14,14" Background="White" BorderBrush="#CDD3D9" BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonUp="Card_Click">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="150">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F4F6F8" Offset="0" />
                                <GradientStop Color="#DCE1E6" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="8,10,8,4" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="{Binding Identity}" Padding="6,1">
                            <TextBlock Text="{Binding ClassLabel}" Foreground="White" FontSize="9.5" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#CC1F262E" Padding="6,1">
                            <TextBlock Text="{Binding ConnectionLabel}" Foreground="White" FontSize="9.5" />
                        </Border>
                    </Grid>
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="#E1E5E9" />
                    <StackPanel Margin="12,9,12,10">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Text.Dim}">
                            <Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Info.Name, Mode=OneWay}" />
                        </TextBlock>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="18" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="IP" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="{Binding AddressText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="Link" Style="{StaticResource Caption}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Lamp}" Fill="{Binding StatusBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Status}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Route" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RouteText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" />
                        </Grid>
                        <DockPanel Margin="0,8,0,3">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BatteryText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding BatteryBrush}" />
                            <TextBlock Text="BATTERY" Style="{StaticResource Caption}" FontSize="9.5" />
                        </DockPanel>
                        <Grid x:Name="bt" Height="6" Background="#E6E9ED">
                            <Rectangle HorizontalAlignment="Left" Fill="{Binding BatteryBrush}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource RatioToWidth}">
                                        <Binding Path="Battery" Converter="{x:Static vm:Percent.ToRatio}" />
                                        <Binding ElementName="bt" Path="ActualWidth" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{x:Static vm:Percent.Same}">
                            <Binding />
                            <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="card" Property="BorderThickness" Value="2" />
                </DataTrigger>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="#8FB0D2" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "+" card -->
        <DataTemplate DataType="{x:Type vm:AddRobotCard}">
            <Button Width="206" Height="304" Margin="0,0,14,14" Cursor="Hand" FocusVisualStyle="{x:Null}"
                    Command="{Binding DataContext.AddRobotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#F6F8FA">
                            <Grid>
                                <Rectangle Stroke="#A9B2BC" StrokeThickness="1.5" StrokeDashArray="5 3" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="#071D39" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource GlyphFont}" FontSize="22" Foreground="#5AA2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Add robot" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,2" />
                                    <TextBlock Text="Connect a physical unit&#x0a;or add a demo AMR / AGV" TextAlignment="Center" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EDF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Toolbar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Show" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                    <ComboBox Width="110" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddRobotCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" /><TextBlock Text="Add robot" Margin="5,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding EditRouteCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" /><TextBlock Text="Edit route" Margin="5,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RemoveRobotCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" /><TextBlock Text="Remove" Margin="5,0,0,0" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Fleet setup" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <!-- discovered on the network -->
                <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0" MinHeight="96" MaxHeight="180">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="robots publishing a factsheet on vantage/v1/+/factsheet" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE701;" Margin="0,0,7,0" FontSize="12" />
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="Discovered on MQTT" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <TextBlock Text="No unassigned robots. Start the VANTAGE adapter on a robot (or switch the workspace to LIVE) to discover it here."
                                       Style="{StaticResource Caption}" Margin="14,10" TextWrapping="Wrap"
                                       Visibility="{Binding Discovered.Count, Converter={StaticResource IsVis}, ConverterParameter=0}" />
                            <DataGrid ItemsSource="{Binding Discovered}" GridLinesVisibility="None"
                                      Visibility="{Binding Discovered.Count, Converter={x:Static vm:Percent.NonZeroVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ROBOT ID" Binding="{Binding Id}" Width="120" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="140" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="MODEL" Binding="{Binding Model}" Width="120" />
                                    <DataGridTextColumn Header="LINK" Binding="{Binding State}" Width="110" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="BATTERY" Binding="{Binding Battery}" Width="80" ElementStyle="{StaticResource MonoCellRight}" />
                                    <DataGridTemplateColumn Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ToolButton}" Height="19" HorizontalAlignment="Left" Content="Add to project"
                                                        Command="{Binding DataContext.AdoptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,4,4">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- detail -->
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <TextBlock Text="Select a robot" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource NotNullToCollapsed}}" />
                    <DockPanel DataContext="{Binding Selected}" Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}">
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="drag to orbit · wheel to zoom" />
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Robot" />
                            </DockPanel>
                        </Border>
                        <Grid DockPanel.Dock="Top" Height="230">
                            <Grid.Background>
                                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.8" RadiusY="0.9">
                                    <GradientStop Color="#FAFBFC" Offset="0" />
                                    <GradientStop Color="#D5DBE1" Offset="1" />
                                </RadialGradientBrush>
                            </Grid.Background>
                            <r:RobotViewer3D ModelKey="{Binding Robot.Model}" />
                            <TextBlock Text="{Binding Info.Name}" Margin="10,8" FontWeight="SemiBold" Foreground="{StaticResource Text.Dim}" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,6,14,14">
                                <TextBlock Text="{Binding Info.Description}" TextWrapping="Wrap" Foreground="{StaticResource Text.Dim}" Margin="0,4,0,4" />
                                <TextBlock Style="{StaticResource SectionLabel}" Text="IDENTITY" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Key}" Text="Robot ID" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Id}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Display name" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Connection" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ConnectionLabel}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="IP address" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IpAddress, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"
                                             IsEnabled="{Binding IsSimulated, Converter={StaticResource Not}}" />
                                </Grid>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="VEHICLE" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Key}" Text="Type" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Info.Family}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Footprint" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding FootprintText}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Speed · payload" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding SpecText}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="Navigation" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Info.Navigation}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="COORDINATION · SIMULATION" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Key}" Text="Priority" />
                                    <TextBox Grid.Column="1" Text="{Binding Priority, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Start delay [s]" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartDelay, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Initial battery %" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InitialBattery, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="Route" />
                                    <DockPanel Grid.Row="3" Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="22" Content="Edit…"
                                                Command="{Binding DataContext.EditRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBlock Style="{StaticResource Value}" Text="{Binding RouteText}" />
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
