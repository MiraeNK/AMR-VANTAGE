<UserControl x:Class="Vantage.Studio.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vantage.Studio.Controls"
             xmlns:vm="clr-namespace:Vantage.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MonitorViewModel}">
    <DockPanel>
        <!-- ═════════════ Toolbar row 1: run control ═════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Toolbar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Scenario" Style="{StaticResource Caption}" Margin="2,0,6,0" />
                <ComboBox Width="290" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" />
                <TextBlock Text="Pairing" Style="{StaticResource Caption}" Margin="12,0,6,0" />
                <ComboBox Width="110" ItemsSource="{Binding Pairings}" SelectedItem="{Binding SelectedPairing}" IsEnabled="{Binding IsProjectScenario, Converter={StaticResource Not}}" />
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding PlayCommand}" ToolTip="Run (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="{StaticResource State.Ok}" />
                        <TextBlock Text="Run" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" ToolTip="Pause (F6)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                        <TextBlock Text="Pause" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding StepCommand}" ToolTip="Step 0.1 s (F10)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" />
                        <TextBlock Text="Step" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ResetCommand}" ToolTip="Reset scenario (Ctrl+R)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                        <TextBlock Text="Reset" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Speed" Style="{StaticResource Caption}" Margin="10,0,6,0" />
                <ComboBox Width="64" ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed}" />
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <TextBlock Text="Transport" Style="{StaticResource Caption}" Margin="2,0,6,0" />
                <ComboBox Width="180" ItemsSource="{Binding Transports}" SelectedItem="{Binding SelectedTransport}" />
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding IsRouteEditorOpen}" ToolTip="Teach fixed lines or planner paths">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" />
                        <TextBlock Text="Route editor" Margin="5,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Command="{Binding LoadMapCommand}" ToolTip="Load ROS occupancy map (.yaml)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE81E;" />
                        <TextBlock Text="Map" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ExportJournalCommand}" ToolTip="Export decision journal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE78C;" />
                        <TextBlock Text="Export" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═════════════ Toolbar row 2: FMR configuration + layers ═════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Toolbar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Layers" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                    <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding ShowGrid}" Content="Grid" />
                    <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding ShowSweeps}" Content="Sweeps" />
                    <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding ShowConflicts}" Content="Conflicts" />
                    <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding ShowReservations}" Content="Reservations" />
                    <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding ShowLimits}" Content="Limits" />
                    <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding ShowLabels}" Content="Labels" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding FitViewCommand}" ToolTip="Fit workspace (Home)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE9A6;" />
                            <TextBlock Text="Fit" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Clearance" Style="{StaticResource Caption}" Margin="2,0,6,0" />
                    <ComboBox Width="210" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
                    <TextBlock Text="Conflict detector" Style="{StaticResource Caption}" Margin="12,0,6,0" />
                    <ComboBox Width="200" ItemsSource="{Binding Detectors}" SelectedItem="{Binding SelectedDetector}" />
                    <TextBlock Text="Priority" Style="{StaticResource Caption}" Margin="12,0,6,0" />
                    <ComboBox Width="170" ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════════════ Work area ═════════════ -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="300" MinWidth="240" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="4" />
                <RowDefinition Height="200" MinHeight="90" />
            </Grid.RowDefinitions>

            <!-- ───────── Left: fleet + scenario + parameters ───────── -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Robots.Count, StringFormat={}{0} units}" />
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Fleet" />
                        </DockPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Style="{StaticResource PanelHeader}" BorderThickness="0,1,0,1">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Scenario" />
                        </Border>
                        <StackPanel Margin="10,6,10,8">
                            <TextBlock Text="{Binding ScenarioTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SectionLabel}" Text="EXPECTED CONFLICT" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding ScenarioExpected}" TextWrapping="Wrap" Foreground="{StaticResource Text.Dim}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Text="CHECKED BEHAVIOUR" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding ScenarioBehaviour}" TextWrapping="Wrap" Foreground="{StaticResource Text.Dim}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding VerdictText, Converter={StaticResource VerdictBrush}}" Padding="8,2" CornerRadius="2" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding VerdictText}" Foreground="White" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                                </Border>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Value}" FontSize="10.5" Text="{Binding DetectionText}" TextWrapping="Wrap" ToolTip="Swept detector vs. raster oracle" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource PanelHeader}" BorderThickness="0,1,0,1">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Normalizer · clearance parameters" />
                        </Border>
                        <Grid Margin="10,6,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Key}" Text="Segment length" />
                            <TextBox Grid.Column="1" Text="{Binding SegmentLength, StringFormat=F2}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="m" Margin="4,0,0,0" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Margin ε" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Margin, StringFormat=F2}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" Text="m" Margin="4,0,0,0" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Release horizon" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Horizon, StringFormat=F1}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Caption}" Text="m" Margin="4,0,0,0" />
                            <Button Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}" Content="Apply &amp; reset" Command="{Binding ApplyParametersCommand}" />
                        </Grid>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Robots}" SelectedItem="{Binding SelectedRobot}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line.Soft}" BorderThickness="0,0,0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Accent.Soft}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Bg.Alt}" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RobotItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{Binding Identity}" />
                                    <StackPanel Grid.Column="1" Margin="9,7,10,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" BorderBrush="{Binding StateBrush}" BorderThickness="1" Padding="5,0" CornerRadius="2">
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="9.5" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                                            </Border>
                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="{Binding ClassLabel}" Style="{StaticResource Caption}" Margin="6,1,0,0" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3,0,4">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" FontSize="10.5" Text="{Binding SpeedText}" />
                                            <TextBlock Style="{StaticResource Value}" FontSize="10.5" Foreground="{StaticResource Text.Dim}" Text="{Binding Mission}" />
                                        </DockPanel>
                                        <Grid x:Name="track" Height="6" Background="#E6E9ED">
                                            <Rectangle HorizontalAlignment="Left" Fill="#C9D1DA">
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                        <Binding Path="LimitRatio" />
                                                        <Binding ElementName="track" Path="ActualWidth" />
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                            </Rectangle>
                                            <Rectangle HorizontalAlignment="Left" Fill="{Binding Identity}">
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                        <Binding Path="ProgressRatio" />
                                                        <Binding ElementName="track" Path="ActualWidth" />
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                            </Rectangle>
                                        </Grid>
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}"><Run Text="limit " /><Run Text="{Binding LimitText, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Text="{Binding ProgressText}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- ───────── Centre: documents ───────── -->
            <TabControl x:Name="Documents" Grid.Row="0" Grid.Column="2" Style="{StaticResource DocTabs}">
                <TabItem Header="Workspace">
                    <Grid>
                        <c:WorkspaceView x:Name="Workspace" Scene="{Binding Scene}" />

                        <!-- Route editor (CAD-style property manager) -->
                        <Border Width="262" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0" Style="{StaticResource Panel}"
                                Visibility="{Binding IsRouteEditorOpen, Converter={StaticResource BoolToVis}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <StackPanel>
                                <Border Style="{StaticResource PanelHeader}" Background="#071D39" BorderThickness="0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="20" Padding="4,0" Foreground="White"
                                                Click="CloseRouteEditor_Click">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" Foreground="White" />
                                        </Button>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" Foreground="#5AA2FF" Margin="0,0,7,0" />
                                        <TextBlock Style="{StaticResource PanelTitle}" Text="Route editor" Foreground="White" />
                                    </DockPanel>
                                </Border>
                                <StackPanel Margin="12,8,12,12">
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="ROBOT" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding RouteRobots}" SelectedItem="{Binding RouteRobot}" DisplayMemberPath="Id" />
                                    <TextBlock Text="{Binding RouteRobotModel}" Style="{StaticResource Caption}" Margin="0,3,0,0" />

                                    <TextBlock Style="{StaticResource SectionLabel}" Text="ROUTE TYPE" Margin="0,10,0,4" />
                                    <RadioButton GroupName="rk" IsChecked="{Binding RouteIsFixed}" Margin="0,2">
                                        <TextBlock><Run Text="Fixed virtual line" FontWeight="SemiBold" /><Run Text="  AGV · nodes kept" Foreground="{StaticResource Text.Faint}" /></TextBlock>
                                    </RadioButton>
                                    <RadioButton GroupName="rk" IsChecked="{Binding RouteIsPlanner}" Margin="0,2">
                                        <TextBlock><Run Text="Simulated planner path" FontWeight="SemiBold" /><Run Text="  AMR · smoothed" Foreground="{StaticResource Text.Faint}" /></TextBlock>
                                    </RadioButton>

                                    <TextBlock Style="{StaticResource SectionLabel}" Text="TEACH" Margin="0,10,0,4" />
                                    <WrapPanel>
                                        <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding IsDrawing, Mode=OneWay}" Command="{Binding ToggleDrawingCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEDFB;" />
                                                <TextBlock Text="Draw" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Button Style="{StaticResource ToolButton}" Command="{Binding NewRouteCommand}" ToolTip="Clear and start a new route">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                                                <TextBlock Text="New" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ToolButton}" Command="{Binding UndoRoutePointCommand}" ToolTip="Remove last point (right-click)">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                                        </Button>
                                        <Button Style="{StaticResource ToolButton}" Command="{Binding ReverseRouteCommand}" ToolTip="Reverse direction">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" />
                                        </Button>
                                    </WrapPanel>
                                    <CheckBox IsChecked="{Binding SnapToGrid}" Content="Snap to 10 cm grid" Margin="0,8,0,0" />
                                    <Border Background="{StaticResource Bg.Alt}" BorderBrush="{StaticResource Line.Soft}" BorderThickness="1" Padding="8,5" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding RouteInfo}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Text.Dim}" />
                                    </Border>
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Command="{Binding ApplyRoutesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="White" FontSize="11" />
                                            <TextBlock Text="Save &amp; load project fleet" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock><Run Text="Segment table" /><Run Text="  " /><Run Text="{Binding Segments.Count, Mode=OneWay}" Foreground="{StaticResource Text.Faint}" FontFamily="{StaticResource MonoFont}" /></TextBlock>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding Segments}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ROBOT" Binding="{Binding Robot}" Width="80" />
                            <DataGridTextColumn Header="REV" Binding="{Binding Revision}" Width="44" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="SEG" Binding="{Binding Index, StringFormat=D2}" Width="44" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="76" />
                            <DataGridTextColumn Header="S START" Binding="{Binding StartS, StringFormat=F2}" Width="66" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="S END" Binding="{Binding EndS, StringFormat=F2}" Width="62" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="LEN" Binding="{Binding Length, StringFormat=F2}" Width="52" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTemplateColumn Header="STATE" Width="104">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="8" Height="8" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding State}" Style="{StaticResource MonoCell}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="AREA" Binding="{Binding Conflict}" Width="74">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
                                        <Setter Property="Foreground" Value="{StaticResource State.Hold}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DECISION" Binding="{Binding Decision}" Width="66" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="GRANTED t" Binding="{Binding Granted}" Width="74" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="ENTERED t" Binding="{Binding Entered}" Width="74" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="RELEASED t" Binding="{Binding Released}" Width="78" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="NODE IN" Binding="{Binding StartNode}" Width="90" ElementStyle="{StaticResource MonoCell}" />
                            <DataGridTextColumn Header="NODE OUT" Binding="{Binding EndNode}" Width="*" ElementStyle="{StaticResource MonoCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Message trace">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Trace}" SelectedItem="{Binding SelectedTrace}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="t [s]" Binding="{Binding TimeText}" Width="62" ElementStyle="{StaticResource MonoCellRight}" />
                                <DataGridTextColumn Header="DIR" Binding="{Binding Direction}" Width="40" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="TOPIC" Binding="{Binding Topic}" Width="230" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="BYTES" Binding="{Binding Bytes}" Width="56" ElementStyle="{StaticResource MonoCellRight}" />
                                <DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary}" Width="*" ElementStyle="{StaticResource MonoCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                        <DockPanel Grid.Column="2">
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" BorderThickness="1,0,0,1">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Payload" />
                            </Border>
                            <TextBox Text="{Binding SelectedTracePayload, Mode=OneWay}" IsReadOnly="True" Height="Auto" BorderThickness="1,0,0,0" VerticalContentAlignment="Top"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11" Background="{StaticResource Bg.Alt}" Padding="8"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- ───────── Bottom: event journal ───────── -->
            <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Caption}" Text="Filter" Margin="0,0,6,0" />
                                <ComboBox Width="110" Height="19" Padding="4,0" FontSize="11" ItemsSource="{Binding JournalFilters}" SelectedItem="{Binding JournalFilter}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Decision journal" />
                            <TextBlock Style="{StaticResource Caption}" Margin="10,0,0,0" Text="grant · queue · revoke · occupancy · release · violations" />
                        </DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Journal}" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="t [s]" Binding="{Binding TimeText}" Width="64" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTemplateColumn Header="KIND" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kind}" Foreground="{Binding KindBrush}" FontWeight="SemiBold" Style="{StaticResource MonoCell}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ROBOT" Binding="{Binding Robot}" Width="76" ElementStyle="{StaticResource MonoCell}" />
                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource MonoCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" />

            <!-- ───────── Right: properties ───────── -->
            <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel DataContext="{Binding SelectedRobot}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Text="{Binding Id}" />
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Properties" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,4,12,12">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="IDENTITY" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Key}" Text="Robot" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Rectangle Width="10" Height="10" Fill="{Binding Identity}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Id}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Vehicle class" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ClassLabel}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Path source" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Source}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="Footprint" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding FootprintText}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource Key}" Text="Priority" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PriorityText}" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="MOTION" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Key}" Text="State" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Pose x, y, θ" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PoseText}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Velocity" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding SpeedText}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="Path progress" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ProgressText}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource Key}" Text="Accum. wait" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding WaitText}" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="CLEARANCE" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Key}" Text="Mission · rev" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Mission}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Release limit" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LimitText}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Last decision" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DecisionText}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="Segments" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding SegmentsText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Style="{StaticResource Key}" Text="Link" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LinkText}" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="REASON" />
                            <Border Background="{StaticResource Bg.Alt}" BorderBrush="{StaticResource Line.Soft}" BorderThickness="1" Padding="8,6">
                                <TextBlock Text="{Binding ReasonText}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Text.Dim}" MinHeight="16" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
