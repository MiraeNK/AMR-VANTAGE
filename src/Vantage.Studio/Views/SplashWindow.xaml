<Window x:Class="Vantage.Studio.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="500" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Title="FMR Vantage" Icon="pack://application:,,,/Assets/fmr-vantage.ico" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <!--
        Two layers share one camera: the full scene is clipped to the card, the hero robot
        is rendered alone and laid over it unclipped, so its mast steps out of the card.
        Absolute image position: top -8, right -40, 600 × 480.
    -->
    <Grid>
        <!-- card -->
        <Border Margin="10,82,10,10" BorderBrush="#C3CCD6" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#EEF2F6" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
                <Image x:Name="Scene" Width="600" Height="480" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-91,-51,0" Stretch="Fill">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#99000000" Offset="0.2" />
                            <GradientStop Color="#FF000000" Offset="0.42" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>

                <Rectangle Height="3" VerticalAlignment="Top" HorizontalAlignment="Left" Width="110" Fill="{StaticResource Brand.Blue}" />

                <!-- status, top -->
                <TextBlock x:Name="Status" Text="Starting…" Foreground="#4A5866" FontSize="12.5" Margin="28,20,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Cancel  ✕" Foreground="#7F8B97" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,18,0"
                           Cursor="Hand" MouseLeftButtonUp="Cancel_Click" Panel.ZIndex="2" />

                <!-- identity, bottom -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,18">
                    <Image Source="{StaticResource Brand.Logo}" Width="300" Stretch="Uniform" HorizontalAlignment="Left" />
                    <TextBlock Text="Fleet Management Robot · segment clearance for mixed AGV / AMR fleets" Foreground="#6B7785" FontSize="11" Margin="20,-6,0,0" />
                </StackPanel>
                <TextBlock Text="Politeknik Manufaktur Bandung · 2026" Foreground="#8A96A2" FontSize="10.5"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,20" />
            </Grid>
        </Border>

        <!-- hero robot, unclipped: steps out over the card edge -->
        <Image x:Name="Hero" Width="600" Height="480" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-40,0" Stretch="Fill" IsHitTestVisible="False">
            <Image.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="300" Opacity="0.35" />
            </Image.Effect>
        </Image>
    </Grid>
</Window>
