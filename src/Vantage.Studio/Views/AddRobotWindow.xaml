<Window x:Class="Vantage.Studio.Views.AddRobotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add robot" Width="860" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="12" Background="{StaticResource Bg.Window}" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#071D39" Height="54">
            <Grid>
                <Rectangle Height="3" VerticalAlignment="Bottom" Fill="#5AA2FF" />
                <StackPanel Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="Add robot to fleet" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Choose a robot type, then connect a physical unit or create a simulated demo unit." Foreground="#AEB6BF" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg.Toolbar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ToolButton}" Content="Cancel" Width="80" IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="Add robot" Width="110" Margin="8,0,0,0" IsDefault="True" Click="Add_Click" />
            </StackPanel>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="ModeDemo" GroupName="mode" IsChecked="True" Style="{StaticResource ToolButton}" Padding="12,3" Checked="Mode_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" />
                            <TextBlock Text="Demo robot (simulation)" Margin="6,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModePhysical" GroupName="mode" Style="{StaticResource ToolButton}" Padding="12,3" Checked="Mode_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE839;" />
                            <TextBlock Text="Connect physical robot" Margin="6,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <ListBox x:Name="Catalog" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Catalog_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,10,10" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Width="250" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="b" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#F7F9FB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Height="118" Background="#EEF1F4">
                                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="6" />
                                </Border>
                                <StackPanel Margin="10,6,10,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4,0" CornerRadius="2">
                                            <TextBlock Text="{Binding ClassLabel}" FontSize="9.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Text.Dim}" />
                                        </Border>
                                        <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Info.Family}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Spec}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Text.Dim}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <StackPanel Margin="14,10">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="IDENTITY" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Key}" Text="Robot ID (MQTT serial)" />
                    <TextBox x:Name="RobotId" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Style="{StaticResource Key}" Text="Display name" Margin="0,8,8,2" />
                    <TextBox x:Name="RobotName" />
                    <StackPanel x:Name="PhysicalFields" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Key}" Text="IP address" Margin="0,8,8,2" />
                        <TextBox x:Name="Ip" FontFamily="{StaticResource MonoFont}" Text="192.168.137.40" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Run the VANTAGE adapter on the robot with this robot ID; it registers itself on vantage/v1/{id}/factsheet." />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="COORDINATION" Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Key}" Text="Priority (1 = highest)" />
                        <TextBox x:Name="Priority" Grid.Column="1" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Start delay [s]" />
                        <TextBox x:Name="Delay" Grid.Row="1" Grid.Column="1" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" Text="0" />
                    </Grid>
                    <CheckBox x:Name="StarterRoute" IsChecked="True" Margin="0,12,0,0" Content="Create a starter route (edit later)" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
