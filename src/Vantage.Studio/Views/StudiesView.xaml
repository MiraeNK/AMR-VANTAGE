<UserControl x:Class="Vantage.Studio.Views.StudiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantage.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StudiesViewModel}">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- study manager -->
        <Border Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Background="#071D39" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Foreground="#5AA2FF" Margin="0,0,7,0" />
                        <TextBlock Style="{StaticResource PanelTitle}" Foreground="White" Text="New study" />
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line.Soft}" BorderThickness="0,0,0,1" Padding="12,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent.Soft}" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg.Alt}" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StudyType}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" Background="#E9ECEF" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- configuration -->
            <Border Style="{StaticResource Panel}" Margin="0,0,0,4">
                <DockPanel Margin="16,12">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Width="220">
                        <Button Style="{StaticResource PrimaryButton}" Height="32" Command="{Binding RunCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="White" FontSize="11" />
                                <TextBlock Text="Run study" Margin="8,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <ProgressBar Height="5" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" Foreground="{StaticResource Accent}" Background="#E6E9ED" BorderThickness="0" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedType.Title}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedType.Question}" Foreground="{StaticResource Text.Dim}" Margin="0,2,0,10" TextWrapping="Wrap" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4" Visibility="{Binding UsesPairings, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Pairings" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                                <CheckBox Content="AGV – AMR" IsChecked="{Binding PairAgvAmr}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox Content="AGV – AGV" IsChecked="{Binding PairAgvAgv}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox Content="AMR – AMR" IsChecked="{Binding PairAmrAmr}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <TextBlock Text="Repetitions" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                                <TextBox Width="44" Text="{Binding Repetitions}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Start jitter ±" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                                <TextBox Width="44" Text="{Binding StartJitter, StringFormat=F2}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" />
                                <TextBlock Text="s" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Clearance parameters (segment length, ε, horizon, priority) are taken from the Monitor workspace. Truth comes from the raster geometry oracle and the occupancy oracle — FMR decisions are never used as labels." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- verdict + chart -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,4">
                <Grid Margin="16,12" MinHeight="120">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="460" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="HYPOTHESIS (II.3.1)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <Border HorizontalAlignment="Left" Padding="12,4" CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource State.Off}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Verdict}" Value="SUPPORTED"><Setter Property="Background" Value="{StaticResource State.Ok}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Verdict}" Value="NOT SUPPORTED"><Setter Property="Background" Value="{StaticResource State.Alarm}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Verdict}" Foreground="White" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </Border>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,20,0" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Chart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChartBar}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" />
                                        <Grid x:Name="track" Grid.Column="1" Height="14" Background="#EEF1F4">
                                            <Rectangle HorizontalAlignment="Left">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Fill" Value="#8A939C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Highlight}" Value="True"><Setter Property="Fill" Value="{StaticResource Accent}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                        <Binding Path="Ratio" />
                                                        <Binding ElementName="track" Path="ActualWidth" />
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                            </Rectangle>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- results -->
            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="20" Command="{Binding ExportCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE78C;" FontSize="11" /><TextBlock Text="Export CSV" Margin="5,0,0,0" /></StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Results" />
                            <TextBlock Style="{StaticResource Caption}" Margin="10,0,0,0" Text="double-click a run to open the scenario in the workspace" />
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" MouseDoubleClick="Results_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SCN" Binding="{Binding Scenario}" Width="42" ElementStyle="{StaticResource MonoCell}" />
                            <DataGridTextColumn Header="PAIRING" Binding="{Binding Pairing}" Width="80" />
                            <DataGridTextColumn Header="CLEARANCE" Binding="{Binding Mode}" Width="118" />
                            <DataGridTextColumn Header="DETECTOR" Binding="{Binding Detector}" Width="*" MinWidth="110" />
                            <DataGridTextColumn Header="REP" Binding="{Binding Repetition}" Width="38" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="TP" Binding="{Binding TP}" Width="40" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="FP" Binding="{Binding FP}" Width="40" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="TN" Binding="{Binding TN}" Width="44" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="FN" Binding="{Binding FN}" Width="40" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="FNR" Binding="{Binding Fnr, StringFormat=F3}" Width="50" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="FPR" Binding="{Binding Fpr, StringFormat=F3}" Width="50" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="INCOMPAT" Binding="{Binding Incompatible}" Width="66" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="ORDER" Binding="{Binding OrderViolations}" Width="52" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="COLL" Binding="{Binding Collisions}" Width="44" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="DONE" Binding="{Binding Completion, StringFormat=P0}" Width="52" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="WAIT [s]" Binding="{Binding TotalWait, StringFormat=F1}" Width="62" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTextColumn Header="T [s]" Binding="{Binding Duration, StringFormat=F1}" Width="52" ElementStyle="{StaticResource MonoCellRight}" />
                            <DataGridTemplateColumn Header="VERDICT" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Verdict, Converter={StaticResource VerdictBrush}}" HorizontalAlignment="Left" Padding="6,0" CornerRadius="2">
                                            <TextBlock Text="{Binding Verdict}" Foreground="White" FontWeight="SemiBold" Style="{StaticResource MonoCell}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
