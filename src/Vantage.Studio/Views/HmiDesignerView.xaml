<UserControl x:Class="Vantage.Studio.Views.HmiDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantage.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HmiDesignerViewModel}" Focusable="True">
    <UserControl.Resources>
        <DrawingBrush x:Key="DotGrid" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F7F8FA" Geometry="M0,0 L16,0 16,16 0,16Z" />
                    <GeometryDrawing Brush="#C9CFD6" Geometry="M0,0 L1.2,0 1.2,1.2 0,1.2Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="DotGridDark" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#2A3037" Geometry="M0,0 L20,0 20,20 0,20Z" />
                    <GeometryDrawing Brush="#3C444D" Geometry="M0,0 L1.5,0 1.5,1.5 0,1.5Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Toolbar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" /><TextBlock Text="Save" Margin="5,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding RunScreenCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="White" FontSize="11" /><TextBlock Text="Run screen" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Screen" Style="{StaticResource Caption}" Margin="2,0,6,0" />
                    <ComboBox Width="200" ItemsSource="{Binding Screens}" SelectedItem="{Binding Screen}" DisplayMemberPath="Name" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding NewScreenCommand}" ToolTip="Blank screen">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" /><TextBlock Text="New" Margin="5,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddTemplateScreenCommand}" ToolTip="Fleet overview template">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A9;" /><TextBlock Text="From template" Margin="5,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteScreenCommand}" ToolTip="Delete screen">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteSelectionCommand}" ToolTip="Delete selection (Del)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" /><TextBlock Text="Delete" Margin="5,0,0,0" /></StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="Screen: drag widgets from the toolbox · Logic: drag nodes, wire output ● → input ● (right-click an input to unlink)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- toolbox -->
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Toolbox" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="WIDGETS" Style="{StaticResource SectionLabel}" Margin="10,8,0,4" />
                            <ItemsControl ItemsSource="{Binding Toolbox}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToolboxItem}">
                                        <Border Background="Transparent" Padding="10,5" Cursor="Hand" ToolTip="{Binding Hint}"
                                                PreviewMouseLeftButtonDown="ToolboxWidget_MouseDown" MouseMove="Toolbox_MouseMove">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="14" Width="22" Foreground="{StaticResource Accent}" />
                                                <TextBlock Text="{Binding Label}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="LOGIC NODES" Style="{StaticResource SectionLabel}" Margin="10,12,0,0" />
                            <ItemsControl ItemsSource="{Binding NodeGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NodeGroup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" Margin="10,6,0,2" />
                                            <ItemsControl ItemsSource="{Binding Nodes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent" Padding="10,4" Cursor="Hand" ToolTip="{Binding Help}"
                                                                PreviewMouseLeftButtonDown="ToolboxNode_MouseDown" MouseMove="Toolbox_MouseMove">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="10" Height="10" Margin="2,0,10,0" Background="{StaticResource Text.Faint}" />
                                                                <TextBlock Text="{Binding Title}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- design surfaces -->
            <TabControl Grid.Column="2" Style="{StaticResource DocTabs}" SelectedIndex="{Binding Tab}">
                <TabItem Header="Screen">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D5DAE0">
                        <Border Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#9AA3AC" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <Canvas x:Name="ScreenCanvas" Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}" Background="{StaticResource DotGrid}"
                                    AllowDrop="True" Drop="ScreenCanvas_Drop" MouseLeftButtonDown="ScreenCanvas_MouseDown" ClipToBounds="True" />
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Logic">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="LogicCanvas" Width="2400" Height="1600" Background="{StaticResource DotGridDark}"
                                AllowDrop="True" Drop="LogicCanvas_Drop" MouseLeftButtonDown="LogicCanvas_MouseDown" MouseMove="LogicCanvas_MouseMove" MouseLeftButtonUp="LogicCanvas_MouseUp" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

            <!-- properties -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Properties" />
                    </Border>
                    <StackPanel Margin="12,8">
                        <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Properties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PropertyItem}">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Key}" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"
                                                 Visibility="{Binding HasChoices, Converter={StaticResource IsVis}, ConverterParameter=False}" KeyDown="PropertyBox_KeyDown" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" Text="{Binding Value}" IsEditable="True"
                                                  Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Widget values can be typed here (static) or driven from the Logic tab with a 'Set widget property' node." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
